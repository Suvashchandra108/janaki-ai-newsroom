# Newsroom production settings. deploy/install.sh creates deploy/.env.production from this and
# fills in every secret marked GENERATED. Never commit the real file. Keep a copy of it in your
# password manager: without it the encrypted CMS key and two-factor secrets cannot be read.

# Public address of the dashboard (DNS A record must point at this server).
NEWSROOM_DOMAIN=newsroom.janakitelevision.com

# --- GENERATED by install.sh -------------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
JWT_SECRET=
API_KEY_PEPPER=
MFA_ENCRYPTION_KEY=

# --- AI (Gemini free tier). install.sh asks for the key with a hidden prompt. ------------------
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_EXTRACTION=gemini-flash-lite-latest
AI_MODEL_WRITING=gemini-flash-lite-latest

# --- Contact sent to Wikimedia with photo requests (their policy asks for one). ----------------
MEDIA_CONTACT=newsroom@janakitelevision.com

CORS_ORIGINS=["https://newsroom.janakitelevision.com"]
