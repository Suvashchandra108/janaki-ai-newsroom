# Copy to .env and replace every value. Never commit .env.
ENVIRONMENT=development

# --- Database (docker compose builds the URLs from these) ---
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=change-me-app
DB_APP_ROLE=janaki_app
# For running the API outside Docker:
# DATABASE_URL=postgresql+psycopg://janaki_app:change-me-app@localhost:5432/janaki
# DATABASE_OWNER_URL=postgresql+psycopg://janaki_owner:change-me-owner@localhost:5432/janaki

# --- Secrets (>= 32 chars in staging/production; the app refuses to start otherwise) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
API_KEY_PEPPER=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- Auth policy ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
MFA_REQUIRED_FOR_ADMINS=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ORIGINS=["http://localhost:3000"]

# --- Background jobs (Phase 2) ---
REDIS_URL=redis://localhost:6379/0
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2000000
DISCOVERY_CLUSTER_WINDOW_HOURS=48

# --- AI gateway (Phase 3+). Free tiers first; no model names are built in. ---
# AI_PROVIDER=none | gemini | openai_compatible   (openai_compatible = Groq, OpenRouter, OpenAI…)
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=            # openai_compatible only, must be https (e.g. the provider's /v1 URL)
AI_MODEL_EXTRACTION=    # model id from your provider's current model list
AI_MODEL_WRITING=       # optional; defaults to AI_MODEL_EXTRACTION
RESEARCH_MAX_DOCUMENTS_PER_EVENT=6
RESEARCH_MAX_CLAIMS_PER_DOCUMENT=8

# --- Media storage (Phase 5) ---
STORAGE_BACKEND=local            # local | s3 (any S3-compatible service, e.g. Cloudflare R2, MinIO)
STORAGE_LOCAL_ROOT=./var/media
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
MEDIA_CONTACT=                   # a contact address sent to Wikimedia in the User-Agent, as their API policy asks

# --- Later phases (not used yet) ---
# SEARCH_API_KEY=
# MINIO_ROOT_PASSWORD=change-me-minio
